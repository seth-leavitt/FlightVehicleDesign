  "motors": {
    "M1100": {
      "key": "M1100",
      "name": "SunnySky X2216 II KV1100",
      "Kv_rpm": 1100.0,
      "resistance": 0.073,
      "current_no_load": 0.9,
      "current_max": 24.0,
      "mass": 0.072,
      "no_load_voltage": 10.0,
      "cells_min": 2,
      "cells_max": 4,
      "notes": "Kv, resistance, no-load current, current_max and mass are SunnySky's published datasheet figures for this winding (no-load current quoted at 10 V); confirm them against the listing at order time. Lowest Kv in the catalog on the larger 22 x 16 mm stator: it turns the big slow-flyer propellers at a speed the data covers and carries 24 A doing it. 26 g heavier than the X2208, which on a 400 g airplane is not nothing. SunnySky recommends a 30 A ESC and the APC 9x4.7, 9x4.5, 9x6, 8x6 and 10x4.7."
    },
    "M1260": {
      "key": "M1260",
      "name": "SunnySky X2208 KV1260",
      "Kv_rpm": 1260.0,
      "resistance": 0.122,
      "current_no_load": 0.4,
      "current_max": 15.0,
      "mass": 0.046,
      "no_load_voltage": 10.0,
      "cells_min": 2,
      "cells_max": 4,
      "notes": "Kv, resistance, no-load current, current_max and mass are SunnySky's published datasheet figures for this winding (no-load current quoted at 10 V); confirm them against the listing at order time. The small 22 x 8 mm stator: lightest and cheapest motor here, the best peak efficiency of the three, and a peak that lands at only 6 A -- the right motor for a light, slow airplane, and RC-1's. SunnySky's static table gives 780 gf at 13.9 A on an APC 9x4.7 SF and 570 gf at 11.7 A on a 10x4.7 SF, both at 11.1 V, and recommends an 18 A ESC."
    },
    "M1400": {
      "key": "M1400",
      "name": "SunnySky X2216 II KV1400",
      "Kv_rpm": 1400.0,
      "resistance": 0.055,
      "current_no_load": 1.3,
      "current_max": 33.0,
      "mass": 0.072,
      "no_load_voltage": 10.0,
      "cells_min": 2,
      "cells_max": 4,
      "notes": "Kv, resistance, no-load current, current_max and mass are SunnySky's published datasheet figures for this winding (no-load current quoted at 10 V); confirm them against the listing at order time. Same can as the KV1100 with fewer turns of thicker wire: lower resistance, a no-load current of 1.3 A, and the WORST peak efficiency of the three despite the highest Kv, because peak efficiency ranks with I0*R. It needs about 16 A to reach that peak; on a small propeller at 3 A it is the least efficient motor here by a wide margin. SunnySky recommends a 40 A ESC and the APC 9x4.7, 9x4.5, 9x6, 8x6 and 7x6."
    },
    "EDF50-4300KV": {
      "key": "EDF50-4300KV",
      "name": "PowerFun 50 mm 11-blade EDF motor, 4300 KV (estimated electrical model)",
      "Kv_rpm": 4300.0,
      "resistance": 0.117,
      "current_no_load": 2.5,
      "current_max": 31.0,
      "mass": 0.062,
      "no_load_voltage": 11.1,
      "cells_min": 3,
      "cells_max": 4,
      "notes": "PUBLISHED: Kv 4300 rpm/V; fan+motor assembly 77 g; 3S static 471 gf at 11.13 V / 20.1 A / 223 W; 4S static 765 gf at 14.79 V / 31.0 A / 458 W; recommended 50 A ESC. Source: PowerFun 50 mm 11-blade 4300 KV EDF, 4-Max listing (https://www.4-max.co.uk/edf-pf-50mm-4S.html). ESTIMATED: resistance 0.117 ohm and no-load current 2.5 A were back-solved so that this motor + EDF50-11B + ESC50 reproduce BOTH published static points inside FlightLab's own model (3S: 471 gf, 20.1 A; 4S: 765 gf, 31.0 A, with motor-terminal voltage = published voltage). They are effective values that absorb ESC/wiring losses, not datasheet figures; implied loaded speed is ~38,100 rpm on 3S and ~48,600 rpm on 4S. ASSUMED: current_max 31 A is the published 4S operating current used as a cap, not a manufacturer continuous rating. MASS: 0.062 kg here + 0.015 kg on EDF50-11B = the published 77 g assembly; the split is arbitrary."
    }
  },
